---
import Base from "./Base.astro";
import Receipt from "../components/Receipt.astro";
import { CASES, SITE } from "../data/site";

interface Props {
  slug: string;
  title: string;
  description: string;
}

const { slug, title, description } = Astro.props;
const item = CASES.find((c) => c.slug === slug)!;
const others = CASES.filter((c) => c.slug !== slug);
const url = `${SITE.url}/work/${slug}/`;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: item.name,
    headline: item.outcome,
    description: item.summary,
    url,
    author: { "@id": `${SITE.url}/#person` },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: `${SITE.url}/` },
      { "@type": "ListItem", position: 2, name: item.name, item: url },
    ],
  },
];
---

<Base title={title} description={description} og={slug} jsonLd={jsonLd}>
  <article>
    <header class="case-head">
      <div class="wrap">
        <p class="eyebrow crumbs"><a href="/">Home</a> / Case No. {item.no} · {item.kicker}</p>
        <div class="case-grid">
          <div>
            <h1>{item.outcome}</h1>
            <p class="lede">{item.summary}</p>
          </div>
          <Receipt item={item} headingLevel="h2" showOutcome={false} />
        </div>
      </div>
    </header>

    <div class="wrap case-body">
      <slot />
    </div>
  </article>

  <nav class="wrap more" aria-labelledby="more-h">
    <h2 id="more-h" class="eyebrow">More work</h2>
    <ul>
      {
        others.map((o) => (
          <li>
            <a href={`/work/${o.slug}/`}>
              <span class="mono">No. {o.no}</span>
              <strong>{o.name}</strong>
              <span>{o.outcome}</span>
            </a>
          </li>
        ))
      }
      <li>
        <a href="/lab/">
          <span class="mono">Lab</span>
          <strong>Working demos</strong>
          <span>Dashboards, data sync, approvals, AI triage, scraping, 3D and MCP.</span>
        </a>
      </li>
    </ul>
  </nav>
</Base>

<style>
  .case-head {
    padding: clamp(28px, 5vw, 56px) 0 clamp(32px, 5vw, 56px);
    border-bottom: 1px solid var(--rule);
  }

  .crumbs {
    margin-bottom: 24px;
  }

  .crumbs a {
    color: var(--muted);
  }

  .case-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px;
    align-items: start;
  }

  @media (min-width: 900px) {
    .case-grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
      gap: 56px;
    }
  }

  h1 {
    font-size: clamp(34px, 5vw, 60px);
    letter-spacing: -0.03em;
    max-width: 18ch;
  }

  .lede {
    font-size: clamp(17px, 1.6vw, 20px);
    color: var(--ink-2);
    max-width: 56ch;
    margin-top: 22px;
  }

  .case-body {
    padding-top: 16px;
  }

  .more {
    margin-top: clamp(56px, 8vw, 96px);
  }

  .more h2 {
    font-family: var(--mono);
    font-weight: 500;
    letter-spacing: 0.08em;
    border-top: 2px solid var(--ink);
    padding-top: 14px;
    margin-bottom: 8px;
  }

  .more ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 860px) {
    .more ul {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 28px;
    }
  }

  .more a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    color: var(--ink);
  }

  .more a:hover strong {
    color: var(--cobalt-ink);
    text-decoration: underline;
  }

  .more .mono {
    font-size: 12px;
    color: var(--muted);
  }

  .more strong {
    font: 700 22px/1.15 var(--display);
  }

  .more a > span:last-child {
    color: var(--ink-2);
    font-size: 15px;
  }
</style>
