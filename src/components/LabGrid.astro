---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { LAB } from "../data/site";

interface Props {
  headingLevel?: "h2" | "h3";
}

const { headingLevel = "h3" } = Astro.props;
const Heading = headingLevel;
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/lab/*.png", { eager: true });
const imageFor = (name: string) => images[`../assets/lab/${name}.png`]?.default;
---

<ul class="lab">
  {
    LAB.map((item, index) => {
      const img = item.image ? imageFor(item.image) : undefined;
      return (
        <li class="lab-item" id={item.slug}>
          <div class="lab-media">
            {img ? (
              <Image
                src={img}
                alt={`${item.name} screenshot`}
                widths={[360, 560, 720]}
                sizes="(min-width: 1000px) 360px, (min-width: 640px) 45vw, 92vw"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={78}
              />
            ) : (
              <div class="lab-term mono">
                <span class="dim"># tools the agent can call</span>
                <span>classify_image → label, confidence</span>
                <span>explain_prediction → heatmap PNG</span>
                <span>get_model_info → classes, threshold</span>
              </div>
            )}
          </div>
          <div class="lab-body">
            <p class="lab-no mono">L-{String(index + 1).padStart(2, "0")} · {item.stack}</p>
            <Heading class="lab-name">{item.name}</Heading>
            <p class="lab-what">{item.what}</p>
            {item.link && (
              <a class="lab-link" href={item.link.href} rel="noopener">
                {item.link.label} <span aria-hidden="true">↗</span>
              </a>
            )}
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .lab {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 36px 28px;
  }

  @media (min-width: 640px) {
    .lab {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1000px) {
    .lab {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .lab-item {
    border-top: 1px solid var(--ink);
    padding-top: 14px;
  }

  .lab-media {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: #f4f5f7;
  }

  .lab-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
  }

  .lab-term {
    margin: 0;
    height: 100%;
    background: var(--ink);
    color: #e6e9ef;
    padding: 18px;
    font-size: 12.5px;
    line-height: 1.7;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
  }

  .lab-term .dim {
    color: #9aa3b2;
  }

  .lab-no {
    margin: 14px 0 4px;
    font-size: 12px;
    color: var(--muted);
  }

  .lab-name {
    font-size: 22px;
  }

  .lab-what {
    margin: 8px 0 0;
    color: var(--ink-2);
    font-size: 15.5px;
  }

  .lab-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    font-weight: 600;
    font-size: 15px;
  }
</style>
